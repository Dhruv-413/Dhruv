{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm ls*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "mcp__next-devtools__*",
      "mcp__shadcn__*"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(npx shadcn*add*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Edit(**/package-lock.json)",
      "Write(**/package-lock.json)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-env.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for secret access..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-gate.mjs\"",
            "timeout": 400,
            "statusMessage": "Quality gate: tsc + eslint..."
          },
          {
            "type": "command",
            "if": "Bash(git -C * commit *)",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-gate.mjs\"",
            "timeout": 400,
            "statusMessage": "Quality gate: tsc + eslint..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-check.mjs\" design",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-check.mjs\" lint",
            "asyncRewake": true,
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "postman@claude-plugins-official": false,
    "prisma@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "microsoft-docs@claude-plugins-official": false
  }
}
